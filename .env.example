# =============================================================
# Backend (copy to backend/.env)
# =============================================================
NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://eightblock:eightblock_dev@localhost:5432/eightblock_db

# CRITICAL: the API refuses to start without a secret of at least 32 characters.
# Generate one with: openssl rand -base64 64
JWT_SECRET=replace-me-with-a-long-random-string

# Public URLs. In production: SITE_URL=https://eightblock.dev, API_URL=https://api.eightblock.dev,
# ADMIN_URL=https://admin.eightblock.dev (the admin app; Google sign-in may return there)
SITE_URL=http://localhost:3000
API_URL=http://localhost:5000
ADMIN_URL=http://localhost:3001

# Browser origins allowed to call the API (comma-separated). Must include SITE_URL and ADMIN_URL.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Number of reverse proxies in front of the API (nginx = 1). Defaults to 1 in production.
TRUST_PROXY=

# Comma-separated IPs exempt from the API rate limit. Add the VPS public IP: server-rendered
# pages call the API through its public URL, so they arrive from the server itself.
RATE_LIMIT_ALLOWLIST=

# Google sign-in (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: ${API_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override, defaults to ${API_URL}/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# Google accounts with these emails become admins on sign-in (comma-separated). Only admins can
# use the admin app.
ADMIN_EMAILS=

# Newsletter and welcome emails via Resend (https://resend.com). Nothing is sent while the key is empty.
# The domain in EMAIL_FROM must be verified in Resend (Domains > Add domain, then add its DNS records).
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=Eightblock <newsletter@news.eightblock.dev>
# Sender for welcome and other account emails; defaults to noreply@ on the newsletter domain
EMAIL_TRANSACTIONAL_FROM=Eightblock <noreply@news.eightblock.dev>
# Optional: where replies go, and a mailing address shown in the email footer
EMAIL_REPLY_TO=
EMAIL_POSTAL_ADDRESS=
# Resend > Webhooks > Add endpoint: {API_URL}/api/webhooks/resend with the email.bounced and
# email.complained events, then paste its signing secret (whsec_...). Bounced and complaining
# addresses are then unsubscribed automatically, which keeps the sending domain out of spam.
RESEND_WEBHOOK_SECRET=
# Senders, double opt-in, welcome emails, article drafts and the weekly digest schedule are
# set in the admin app under Newsletter > Settings. The EMAIL_* values above are the defaults it falls back to.

# Redis is required: sessions are rejected while it is unreachable.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# PostgreSQL (used by docker-compose)
POSTGRES_USER=eightblock
POSTGRES_PASSWORD=eightblock_dev
POSTGRES_DB=eightblock_db

# =============================================================
# Frontend (copy to frontend/.env.local; on the server use frontend/.env.production)
# NEXT_PUBLIC_* values are inlined at build time: rebuild after changing them.
# =============================================================
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# =============================================================
# Admin app (copy to admin/.env.local; on the server use admin/.env.production)
# The same three values as the frontend. Runs on port 3001 in development.
# =============================================================
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# =============================================================
# deploy.sh (optional, read from the shell environment of the deploy user)
# =============================================================
# FRONTEND_PORT=3006                          # port nginx proxies the site to
# ADMIN_PORT=3007                             # port nginx proxies the admin app to
# HEALTH_TIMEOUT=90                           # seconds to wait for the new build to become healthy
# DB_BACKUP_DIR=$HOME/backups/eightblock      # pg_dump taken before every schema change
# DB_BACKUP_KEEP=14                           # number of backups to keep
# SKIP_DB_BACKUP=1                            # skip the backup (not recommended)
