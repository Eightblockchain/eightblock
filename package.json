{
  "name": "eightblock",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx}\"",
    "dev:frontend": "pnpm --filter ./frontend dev",
    "dev:admin": "pnpm --filter ./admin dev",
    "dev:backend": "pnpm --filter ./backend dev"
  },
  "devDependencies": {
    "prettier": "^3.2.5"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.12": "^8.5.28",
      "nanoid@<3.3.16": "^3.3.19",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4 <4.0.4": "^4.0.7",
      "yaml@>=2 <2.8.3": "^2.9.1",
      "browserslist@<4.28.7": "^4.29.2",
      "diff@>=5 <5.2.2": "^5.2.2",
      "postcss-selector-parser@>=6.1 <6.1.3": "^6.1.3",
      "@babel/core@<7.29.6": "^7.29.6"
    }
  }
}
